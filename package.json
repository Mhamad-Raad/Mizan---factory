{
  "name": "mizan",
  "private": true,
  "version": "0.1.0",
  "description": "Mizan — factory materials, orders and supplier-accounting web system",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @mizan/api build && pnpm --filter @mizan/web build",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . && pnpm lint:css",
    "lint:css": "stylelint \"apps/web/src/**/*.css\" \"packages/ui/src/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:routes": "pnpm --filter @mizan/api check:routes",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "db:up": "pnpm --filter @mizan/api db:up",
    "db:migrate": "pnpm --filter @mizan/api migrate",
    "db:seed": "pnpm --filter @mizan/api seed",
    "dev": "pnpm --parallel --filter @mizan/api --filter @mizan/web dev",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:i18n && pnpm check:contrast && pnpm test",
    "build:packages": "tsc -b packages/money packages/text packages/permissions packages/i18n packages/ledger",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mizan/i18n": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-use-logical": "^2.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "prisma",
      "argon2"
    ]
  },
  "type": "module"
}
