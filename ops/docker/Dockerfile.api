# Mizan API. Multi-stage so the runtime image carries no toolchain and no sources.
FROM node:24-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /repo

# Manifests first: this layer is rebuilt only when a dependency changes, not on every edit.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json tsconfig.json ./
COPY packages/money/package.json        packages/money/
COPY packages/text/package.json         packages/text/
COPY packages/permissions/package.json  packages/permissions/
COPY packages/i18n/package.json         packages/i18n/
COPY packages/ledger/package.json       packages/ledger/
COPY packages/ui/package.json           packages/ui/
COPY apps/api/package.json              apps/api/
COPY apps/web/package.json              apps/web/
RUN pnpm install --frozen-lockfile --filter @mizan/api...

COPY packages packages
COPY apps/api apps/api
RUN pnpm --filter @mizan/api exec tsc -b

# Prune to production dependencies for the runtime image.
RUN pnpm install --frozen-lockfile --prod --filter @mizan/api...

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production TZ=Asia/Baghdad
RUN useradd --system --uid 10001 --create-home mizan
WORKDIR /app

COPY --from=build --chown=mizan:mizan /repo/node_modules            /app/node_modules
COPY --from=build --chown=mizan:mizan /repo/packages                /app/packages
COPY --from=build --chown=mizan:mizan /repo/apps/api/node_modules   /app/apps/api/node_modules
COPY --from=build --chown=mizan:mizan /repo/apps/api/dist           /app/apps/api/dist
COPY --from=build --chown=mizan:mizan /repo/apps/api/prisma         /app/apps/api/prisma
COPY --from=build --chown=mizan:mizan /repo/apps/api/package.json   /app/apps/api/package.json

USER mizan
EXPOSE 3000
# The process refuses to start on a pending migration (spec 2.14), so a bad deploy fails
# loudly here instead of serving requests against a schema it does not expect.
CMD ["node", "apps/api/dist/main.js"]
