# Caddy terminates TLS with Let's Encrypt, serves the SPA and proxies the API, so the
# browser sees one origin — which is what makes the SameSite=Lax session cookie work
# without any cross-site exception (spec 2.8, 2.14).

{$MIZAN_DOMAIN:localhost} {
	encode zstd gzip

	header {
		# Section 2.13. The pre-paint script is inline by necessity, so it is allowed by hash;
		# `mizan-preflight` replaces the placeholder at build time.
		Content-Security-Policy "default-src 'self'; script-src 'self' '{$MIZAN_CSP_INLINE_HASH}'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Hashed assets are immutable; index.html must never be cached, or a deploy would
		# leave a phone on the floor running last week's application.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
