# Copy to .env and fill in. Names follow the specification (sections 2.8, 2.13, 2.14).
DATABASE_URL=postgresql://mizan_app:CHANGE_ME@localhost:5432/mizan
DATABASE_MIGRATE_URL=postgresql://mizan_migrate:CHANGE_ME@localhost:5432/mizan
SESSION_PEPPER=CHANGE_ME_256_BIT_RANDOM
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME_TEMPORARY
APP_BASE_URL=https://mizan.example.com
TZ=Asia/Baghdad
BACKUP_BUCKET=s3://mizan-backups
BACKUP_ENCRYPTION_KEY=CHANGE_ME
# The off-site store the backup container uploads to (S3, or B2/Wasabi via AWS_ENDPOINT_URL).
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=
BACKUP_HEARTBEAT_URL=
ERROR_TRACKING_DSN=
# Wrong passwords per network address per hour, across sign-in, unlock and change password, and
# how long an address that reaches it is refused. Only wrong passwords count, so the whole
# factory signing in from one address never reaches it.
SIGN_IN_FAILURES_PER_HOUR=100
SIGN_IN_BLOCK_MINUTES=5
# The tag the API and the migrate job are built and run as (compose.yml); e.g. the release tag.
MIZAN_IMAGE_TAG=
