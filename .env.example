# Copy to .env and fill in. Names follow the specification (sections 2.8, 2.13, 2.14).
DATABASE_URL=postgresql://mizan_app:CHANGE_ME@localhost:5432/mizan
DATABASE_MIGRATE_URL=postgresql://mizan_migrate:CHANGE_ME@localhost:5432/mizan
SESSION_PEPPER=CHANGE_ME_256_BIT_RANDOM
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME_TEMPORARY
APP_BASE_URL=https://mizan.example.com
TZ=Asia/Baghdad
BACKUP_BUCKET=s3://mizan-backups
BACKUP_ENCRYPTION_KEY=CHANGE_ME
ERROR_TRACKING_DSN=
# Sign-in attempts per network address per door (sign-in, unlock, change password). The whole
# factory usually reaches the server from one address, so keep these generous.
SIGN_IN_LIMIT_PER_MINUTE=30
SIGN_IN_LIMIT_PER_HOUR=200
