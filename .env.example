# Copy to .env and fill in. Names follow the specification (sections 2.8, 2.13, 2.14).
DATABASE_URL=postgresql://mizan_app:CHANGE_ME@localhost:5432/mizan
DATABASE_MIGRATE_URL=postgresql://mizan_migrate:CHANGE_ME@localhost:5432/mizan
SESSION_PEPPER=CHANGE_ME_256_BIT_RANDOM
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME_TEMPORARY
APP_BASE_URL=https://mizan.example.com
TZ=Asia/Baghdad
BACKUP_BUCKET=s3://mizan-backups
BACKUP_ENCRYPTION_KEY=CHANGE_ME
# The backup container's own database role, mizan_backup (read everything, replicate, write
# nothing), created with this password when the database volume is first initialised
# (ops/docker/db-init). Generate it: openssl rand -base64 32
BACKUP_DB_PASSWORD=CHANGE_ME
# The off-site store the backup container uploads to (S3, or B2/Wasabi via AWS_ENDPOINT_URL).
# The key should be put-only (runbook, "Off-site retention"): the bucket's lifecycle rules and
# Object Lock keep and expire the copies, so a stolen host key cannot delete them.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=
# The dead-man's switch (e.g. a healthchecks.io check, one ping a night). Leave it empty and the
# backup container warns at every start and every night that nobody will hear when backups stop.
BACKUP_HEARTBEAT_URL=
# 1 = prune off-site copies from the host instead of by bucket lifecycle rules (needs a key that
# may list and delete — not recommended). 0 by default.
BACKUP_PRUNE_OFFSITE=0
ERROR_TRACKING_DSN=
# Wrong passwords per network address per hour, across sign-in, unlock and change password, and
# how long an address that reaches it is refused. Only wrong passwords count, so the whole
# factory signing in from one address never reaches it.
SIGN_IN_FAILURES_PER_HOUR=100
SIGN_IN_BLOCK_MINUTES=5
# The tag the API and the migrate job are built and run as (compose.yml); e.g. the release tag.
MIZAN_IMAGE_TAG=
# Development only: the port Vite serves the web app on (5173 when unset). PORT is the API's;
# change both, and APP_BASE_URL to match, when another project already uses them.
WEB_PORT=5173
