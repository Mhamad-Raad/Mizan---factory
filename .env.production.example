# Jiyan Management — production settings. Copy to `.env` on the server and fill in every value
# marked CHANGE_ME. DEPLOY.md walks through each one. Never commit the filled-in `.env`.
#
# Generate every secret with:   openssl rand -base64 32
# (For the two database passwords use: openssl rand -hex 24 — they go inside URLs below.)

# ── the address ───────────────────────────────────────────────────────────────────────────
# The domain the system is reached at. Point its DNS A record at this server first; Caddy then
# obtains the HTTPS certificate on its own.
MIZAN_DOMAIN=jiyan.example.com
APP_BASE_URL=https://jiyan.example.com

# ── the database ──────────────────────────────────────────────────────────────────────────
# The schema owner, used only by the one-off migrate job.
POSTGRES_USER=mizan_migrate
POSTGRES_DB=mizan
POSTGRES_PASSWORD=CHANGE_ME_MIGRATE_PASSWORD
DATABASE_MIGRATE_URL=postgresql://mizan_migrate:CHANGE_ME_MIGRATE_PASSWORD@db:5432/mizan
# The role the application runs as (no right to change the ledgers' history). Pick a second
# password here; DEPLOY.md step 6 gives it to the role after the first migration creates it.
DATABASE_URL=postgresql://mizan_app:CHANGE_ME_APP_PASSWORD@db:5432/mizan

# ── sign-in ───────────────────────────────────────────────────────────────────────────────
# Mixed into every session token's hash. Generate once; changing it signs everybody out.
SESSION_PEPPER=CHANGE_ME
# The first administrator, created once by DEPLOY.md step 7. The password is temporary: the
# system asks for a new one at the first sign-in. Delete this line from `.env` afterwards.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME_TEMPORARY

# ── backups (DEPLOY.md step 3 sets up the storage) ────────────────────────────────────────
# Where the encrypted copies go: any S3-compatible storage (AWS S3, Backblaze B2, Wasabi…).
BACKUP_BUCKET=s3://jiyan-backups
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
# For B2, Wasabi or another non-AWS store, its endpoint, e.g. https://s3.eu-central-003.backblazeb2.com
AWS_ENDPOINT_URL=
# Encrypts every copy before it leaves the server. Keep a copy OFF the server (a password
# manager): without it no backup can ever be read.
BACKUP_ENCRYPTION_KEY=CHANGE_ME
# The backup job's own read-only database login.
BACKUP_DB_PASSWORD=CHANGE_ME
# A monitoring URL pinged after every good night (e.g. a free healthchecks.io check). If the
# pings stop, it e-mails you: the only way a silently broken backup gets noticed.
BACKUP_HEARTBEAT_URL=
# Leave 0: old copies are expired by the storage's own lifecycle rules (DEPLOY.md step 3).
BACKUP_PRUNE_OFFSITE=0

# ── optional ──────────────────────────────────────────────────────────────────────────────
# A version label for the images, e.g. the git tag being deployed. Defaults to "local".
MIZAN_IMAGE_TAG=
# An error-tracking service's DSN (Sentry or compatible). Empty = errors go to the logs only.
ERROR_TRACKING_DSN=
